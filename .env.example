# Curtail environment template.
# Copy to .env.local and fill in. Never commit a real .env.
# Every value here is a placeholder. Secrets live in Secret Manager in
# deployed environments; this file exists so a stranger can run the project.

# ---------------------------------------------------------------------------
# Google Cloud
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
# Agent Registry, Gateway, and Model Armor must be co-located with the app,
# in the same project and region. Multi-region eu and us registries do not
# support manual registration of agents, endpoints, and MCP servers.
GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Models. Gemini 3.5 or newer is a hard hackathon requirement.
# Set GOOGLE_GENAI_USE_VERTEXAI=true to route through Vertex AI instead of
# the Gemini API. Both satisfy the requirement.
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=your-gemini-api-key
MODEL_SCRIBE=gemini-3.5-flash
# Where the model is served from. `global`, not a region, and that is a finding
# rather than a preference: gemini-3.5-flash is listed in the Vertex catalogue
# for us-central1 and returns 404 NOT_FOUND when called there on this project,
# as do us-east5 and europe-west4. Only `global` serves it.
VERTEX_LOCATION=global
MODEL_SENTINEL=gemini-3.5-flash-lite
MODEL_HERALD=gemini-3.5-flash-lite
MODEL_NORMALIZER=gemma-4-26b-a4b-it
MODEL_EMBEDDING=gemini-embedding-001

# ---------------------------------------------------------------------------
# Governance. Leave the GEAP values blank to run the documented Plan B2
# mapping (per-service-account IAM, API Gateway, standalone Model Armor).
# The Fortified Enterprise Fleet FAQ confirms these are recommended,
# not required.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# The officer-token signing key. There is NO default and there must never be
# one: a value committed here would let any deployment that forgot to configure
# a key mint signatures with a published secret, and signing is the act this
# whole system exists to protect. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 bytes. In deployed environments this lives in Secret Manager.
# ---------------------------------------------------------------------------
CURTAIL_SIGNING_KEY=generate-your-own-at-least-32-bytes

# The shared secret a caller must present before ANY officer token is minted.
# There is no default and the endpoint refuses without it.
#
# The demo login was originally ungated: it took a role and a free-text officer
# id and minted a Deputy Director token for anyone who asked, on a public URL.
# A MAC proves the server issued a token and nothing about who asked for it, so
# the identity behind every signature was whatever a stranger had typed. That is
# not a weaker administrative record than none, it is a fabricated one.
#
# A real deployment replaces this with IAP or another identity provider.
CURTAIL_DEMO_PASSPHRASE=generate-your-own-and-give-it-to-reviewers

AGENT_REGISTRY_ENDPOINT=
AGENT_GATEWAY_ENDPOINT=
MODEL_ARMOR_TEMPLATE=projects/your-project-id/locations/us-central1/templates/curtail-scribe

# ---------------------------------------------------------------------------
# Data layer. Cloud SQL is the source of truth; Firestore is a derived
# realtime projection and is NEVER written independently.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Eventing. Exactly-once delivery is supported only on pull subscriptions.
# Ordering keys are high cardinality, by water right or by gage, never one
# global key.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# USGS. Free key raises the rate limit from 100 to 1,000 requests per hour.
# Sign up at https://api.waterdata.usgs.gov/signup/
# Legacy waterservices is decommissioned in Q1 2027; the OGC API is primary.
# ---------------------------------------------------------------------------
USGS_API_KEY=your-usgs-api-key

# ---------------------------------------------------------------------------
# Demo determinism. When true, the replay driver serves cached GCS snapshots
# instead of live USGS calls, and the console shows a visible live-versus-
# cached flag so the demo is never misleading.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Field layer (PWA). The device authenticates a human and holds a short-lived
# ID token. It never holds an agent identity or a service account key.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Console
# ---------------------------------------------------------------------------

# ===========================================================================
# PLANNED, NOT WIRED.
#
# Everything below is in the architecture and nothing in the shipped code
# reads it. It is kept because the design is real and these are the seams the
# next milestones attach to, and it is SEPARATED because a config template is
# where plan-tier claims survive after the prose has been fixed: a reader
# diffing this file against the README would otherwise find the project
# advertising a database, a message bus and push notifications it does not
# have.
#
# `core/tests/test_env_template.py` enforces the split in both directions. To
# wire one of these, move it up into the section it belongs to; that test will
# tell you if you forget.
# ===========================================================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/curtail
CLOUD_SQL_INSTANCE=your-project-id:us-central1:curtail-pg
FIRESTORE_DATABASE=(default)
GCS_CORPUS_BUCKET=curtail-corpus
GCS_DRAFTS_BUCKET=curtail-drafts
PUBSUB_TOPIC_GAGE_EVENTS=curtail-gage-events
PUBSUB_TOPIC_ORDER_DRAFTS=curtail-order-drafts
PUBSUB_TOPIC_NOTIFICATIONS=curtail-notifications
PUBSUB_DLQ_TOPIC=curtail-dead-letter
PUBSUB_MAX_DELIVERY_ATTEMPTS=10
USGS_OGC_BASE_URL=https://api.waterdata.usgs.gov/ogcapi/v0
GAGE_SCOTT=USGS-11519500
GAGE_SHASTA=USGS-11517500
CURTAIL_REPLAY_MODE=false
CURTAIL_REPLAY_SEASON=2026
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_BUILD_SHA=local
